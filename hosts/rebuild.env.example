# Made-up example of a dev env's rebuild.env for hosts/rebuild-k8s.sh. The real one lives only in
# the env folder on the controller (mode 0700, the file 0600), outside this repository; its paths
# are private. Runbook: docs/runbooks/rebuild-k8s-layer-with-one-command.md.
ENV_NAME=dev
VM_ID_MIN=250
VM_ID_MAX=257
TFVARS=/path/to/env-dir/k8s.tfvars
TFSTATE=/path/to/env-dir/k8s.tfstate
TOFU_ENV=/path/to/env-dir/tofu.env
INVENTORY=/path/to/env-dir/inventory/
# Dev leaves out certs, identity and ui (D-0028). restore runs after storage made the data disk and
# before gitops, so local-path finds each restored folder when Argo CD makes its claim.
STAGES="vms cluster storage restore gitops apps gateway checks"
# Restore a read-only copy of prod's newest volume snapshot (TASK-0240, the owner's card,
# 2026-11-10 02:50 UTC), and prove it in the checks stage. The script exports REPO and INVENTORY.
RESTORE_HOOK='cd "$REPO/hosts/ansible" && ansible-playbook -i "$INVENTORY" playbooks/k8s-restore.yml'
RESTORE_CHECK_HOOK='cd "$REPO/hosts/ansible" && ansible-playbook -i "$INVENTORY" playbooks/k8s-restore.yml --tags restore_check'
