# The Argo CD web UI through the shared Gateway (tag ui). TLS ends at the Gateway's HTTPS listener
# with the wildcard certificate; Argo CD runs with server.insecure: "true", so the Gateway talks
# plain HTTP to Service argocd-server port 80 (Argo CD 3.5 docs, operator-manual/ingress.md,
# "Gateway API Example": "TLS termination at the Gateway", "Routing HTTP requests").
# sectionName pins the UI to the https listener, so it is never served over plain HTTP.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd-ui
  namespace: {{ k8s_gitops_pick.namespace }}
spec:
  parentRefs:
    - name: {{ k8s_gitops_ui_gateway_name }}
      namespace: {{ k8s_gitops_ui_gateway_namespace }}
      sectionName: https
  hostnames:
    - {{ k8s_gitops_ui_host }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: argocd-server
          port: 80
{% if k8s_gitops_ui_https_redirect %}
---
# Plain HTTP for the UI's name gets a 301 to the same URL on https:// (Gateway API
# HTTPRequestRedirectFilter: with scheme https and no port, the port is 443 and is left out of the
# Location header). No backend: nothing reaches Argo CD over this listener.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd-ui-redirect
  namespace: {{ k8s_gitops_pick.namespace }}
spec:
  parentRefs:
    - name: {{ k8s_gitops_ui_gateway_name }}
      namespace: {{ k8s_gitops_ui_gateway_namespace }}
      sectionName: http
  hostnames:
    - {{ k8s_gitops_ui_host }}
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
{% endif %}
