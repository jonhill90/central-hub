# {{ ansible_managed }}
# Anonymous HTTPS, no repository secret: the cluster holds no git credential (Activation gate item 3).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cluster
  namespace: argocd
spec:
  project: {{ k8s_gitops_project }}
  source:
    repoURL: {{ k8s_gitops_source_url }}
    targetRevision: {{ k8s_gitops_source_branch }}
    path: {{ k8s_gitops_source_path }}
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
