# {{ ansible_managed }}
# The one Application that reads central-hub (D-0023 rule 5; c1 may read it before the Activation
# gate, D-0027). It renders the root chart in {{ k8s_gitops_root_path }}, which makes one child
# Application per component. Anonymous HTTPS, no repository secret: the cluster holds no git
# credential (Activation gate item 3). The zone (and the Gateway's address) are Helm parameters here, so it lives only in the
# cluster, never in git (CLAUDE.md rule 4). No resources finalizer: deleting this Application leaves
# the child Applications and their objects in place.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ k8s_gitops_root_name }}
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ k8s_gitops_source_url }}
    targetRevision: {{ k8s_gitops_source_branch }}
    path: {{ k8s_gitops_root_path }}
    helm:
      releaseName: {{ k8s_gitops_root_name }}
      parameters:
        - name: zone
          value: "{{ k8s_gitops_source_zone }}"
{% if k8s_gitops_source_gateway_address | default('') | length > 0 %}
        - name: gatewayAddress
          value: "{{ k8s_gitops_source_gateway_address }}"
{% endif %}
{% if not (k8s_gitops_source_gateway_https | bool) %}
        - name: gatewayHttps
          value: "false"
{% endif %}
{% if k8s_gitops_source_local_path_stable_folders | bool %}
        - name: localPathStableFolders
          value: "true"
{% endif %}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
---
# The cluster's own entry: a cluster Secret for the local cluster, so it has a name and labels
# (STD-0001 "Cluster labels"). No credential in it: Argo CD uses its own service account in-cluster.
apiVersion: v1
kind: Secret
metadata:
  name: cluster-{{ k8s_gitops_cluster_name }}
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: cluster
{% for key, value in k8s_gitops_cluster_labels | dictsort %}
    {{ key }}: "{{ value }}"
{% endfor %}
type: Opaque
stringData:
  name: {{ k8s_gitops_cluster_name }}
  server: https://kubernetes.default.svc
  config: '{"tlsClientConfig":{"insecure":false}}'
