# A throwaway CA for a dev cluster, made by cert-manager inside the cluster: a self-signed root and
# a ClusterIssuer that signs with it, then the Gateway's wildcard certificate from that issuer. No key
# leaves the cluster, nothing is read from the controller and no public service is called, so a dev
# rebuild gets HTTPS for the sign-in proof without any prod secret (the Cloudflare token, the lab
# CA's key). Nothing trusts this root: clients verify nothing or read it from Secret {{ k8s_certs_dev_ca_name }}.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ k8s_certs_dev_ca_name }}-selfsigned
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ k8s_certs_dev_ca_name }}
  namespace: {{ k8s_certs_namespace }}
spec:
  isCA: true
  commonName: dev-ca (throwaway, per rebuild)
  secretName: {{ k8s_certs_dev_ca_name }}
  duration: 8760h
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: {{ k8s_certs_dev_ca_name }}-selfsigned
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ k8s_certs_dev_ca_name }}
spec:
  ca:
    secretName: {{ k8s_certs_dev_ca_name }}
---
# The same wildcard certificate as issuers.yaml.j2 makes, so the Gateway's listener finds Secret
# {{ k8s_certs_secret_name }} where it always looks.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ k8s_certs_certificate_name }}
  namespace: {{ k8s_certs_gateway_namespace }}
spec:
  secretName: {{ k8s_certs_secret_name }}
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: {{ k8s_certs_dev_ca_name }}
  dnsNames:
    - "{{ k8s_certs_wildcard }}"
{% if k8s_certs_short_names %}
    - "*.{{ k8s_certs_zone }}"
{% endif %}
  privateKey:
    algorithm: ECDSA
    size: 256
    rotationPolicy: Always
