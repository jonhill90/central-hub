# The Proxmox host's certificate (D-0028 rule 5). Its Secret holds tls.crt (with the c1
# intermediate), tls.key and ca.crt (the lab root).
apiVersion: v1
kind: Namespace
metadata:
  name: {{ proxmox_cert_namespace }}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ proxmox_cert_name }}
  namespace: {{ proxmox_cert_namespace }}
spec:
  secretName: {{ proxmox_cert_name }}-tls
  duration: {{ proxmox_cert_duration }}
  renewBefore: {{ proxmox_cert_renew_before }}
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: {{ proxmox_cert_issuer }}
  dnsNames:
{% for name in proxmox_cert_names %}
    - "{{ name }}"
{% endfor %}
  privateKey:
    algorithm: ECDSA
    size: 256
    rotationPolicy: Always
