# {{ ansible_managed }} (role k8s_backup)
[Unit]
Description=Prove the newest c1 off-box backups restore (restic, etcd)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=CENTRAL_HUB_BACKUP_ENV={{ k8s_backup_node_env_file }}
Environment=BACKUP_STATE={{ k8s_backup_state_dir }}
Environment=RESTIC_CACHE_DIR=/var/cache/central-hub-backup
{% if k8s_backup_is_control_plane %}
ExecStart={{ k8s_backup_bin_dir }}/c1-restore-test-etcd.sh
{% endif %}
ExecStart={{ k8s_backup_bin_dir }}/c1-restore-test-volumes.sh
Nice=10
IOSchedulingClass=idle
