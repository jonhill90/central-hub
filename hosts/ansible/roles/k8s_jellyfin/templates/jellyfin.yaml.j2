# {{ ansible_managed }}
# Jellyfin (role k8s_jellyfin, BUILD-PATH S17): one pod, its settings and media on claims from the
# StorageClass, a Service for the route. Recreate, because a ReadWriteOnce volume on one node can't
# be held by two pods while a rolling update runs.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k8s_jellyfin_namespace }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ k8s_jellyfin_name }}-config
  namespace: {{ k8s_jellyfin_namespace }}
spec:
{% if k8s_jellyfin_storage_class | length > 0 %}
  storageClassName: {{ k8s_jellyfin_storage_class }}
{% endif %}
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ k8s_jellyfin_config_size }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ k8s_jellyfin_name }}-media
  namespace: {{ k8s_jellyfin_namespace }}
spec:
{% if k8s_jellyfin_storage_class | length > 0 %}
  storageClassName: {{ k8s_jellyfin_storage_class }}
{% endif %}
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ k8s_jellyfin_media_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ k8s_jellyfin_name }}
  namespace: {{ k8s_jellyfin_namespace }}
  labels: {app.kubernetes.io/name: jellyfin}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: jellyfin}
  template:
    metadata:
      labels: {app.kubernetes.io/name: jellyfin}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ k8s_jellyfin_uid }}
        runAsGroup: {{ k8s_jellyfin_uid }}
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: jellyfin
          image: {{ k8s_jellyfin_image }}
          ports:
            - {name: http, containerPort: {{ k8s_jellyfin_port }}}
          startupProbe:
            httpGet: {path: {{ k8s_jellyfin_health_path }}, port: http}
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: {{ k8s_jellyfin_health_path }}, port: http}
            periodSeconds: 10
          livenessProbe:
            httpGet: {path: {{ k8s_jellyfin_health_path }}, port: http}
            periodSeconds: 30
            timeoutSeconds: 10
          resources:
            requests: {cpu: {{ k8s_jellyfin_cpu_request }}, memory: {{ k8s_jellyfin_memory_request }}}
            limits: {memory: {{ k8s_jellyfin_memory_limit }}}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: config, mountPath: /config}
            - {name: cache, mountPath: /cache}
            - {name: media, mountPath: /media}
      volumes:
        - name: config
          persistentVolumeClaim: {claimName: {{ k8s_jellyfin_name }}-config}
        - name: media
          persistentVolumeClaim: {claimName: {{ k8s_jellyfin_name }}-media}
        - name: cache
          emptyDir: {sizeLimit: {{ k8s_jellyfin_cache_limit }}}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ k8s_jellyfin_name }}
  namespace: {{ k8s_jellyfin_namespace }}
spec:
  selector: {app.kubernetes.io/name: jellyfin}
  ports:
    - {name: http, port: {{ k8s_jellyfin_port }}, targetPort: http}
