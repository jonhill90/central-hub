# {{ ansible_managed }}
# Realm {{ k8s_identity_realm }}, as code: its groups, users and the OIDC clients of every lab app.
# KeycloakRealmImport only creates a realm that doesn't exist; it never updates or deletes one
# (Keycloak operator docs, "Automating a realm import"). So when this file or a value changes, the
# role deletes the realm and imports it again (k8s_identity_realm_replace, tasks/keycloak.yml).
# The ${...} placeholders come from Secret {{ k8s_identity_realm_secret }}, filled from the values
# file on the controller, so no secret value is in this file.
{% set mappers %}
        protocolMappers:
          # The realm roles as a `roles` claim (Grafana's role_attribute_path reads it).
          - name: realm roles
            protocol: openid-connect
            protocolMapper: oidc-usermodel-realm-role-mapper
            config:
              claim.name: roles
              multivalued: "true"
              jsonType.label: String
              id.token.claim: "true"
              access.token.claim: "true"
              userinfo.token.claim: "true"
          # The groups as a `groups` claim, plain names (Argo CD RBAC, the Jellyfin plugin).
          - name: groups
            protocol: openid-connect
            protocolMapper: oidc-group-membership-mapper
            config:
              claim.name: groups
              full.path: "false"
              id.token.claim: "true"
              access.token.claim: "true"
              userinfo.token.claim: "true"
{% endset %}
apiVersion: k8s.keycloak.org/v2beta1
kind: KeycloakRealmImport
metadata:
  name: realm-{{ k8s_identity_realm }}
  namespace: {{ k8s_identity_namespace }}
{% if k8s_identity_values_sha256 is defined %}
  annotations:
    # A hash of the values, not the values: a changed password or secret makes this file differ,
    # which is what starts a new import.
    central-hub/values-sha256: "{{ k8s_identity_values_sha256 }}"
{% endif %}
spec:
  keycloakCRName: {{ k8s_identity_name }}
  placeholders:
{% for key in k8s_identity_value_keys %}
    {{ key }}:
      secret: {name: {{ k8s_identity_realm_secret }}, key: {{ key }}}
{% endfor %}
  realm:
    realm: {{ k8s_identity_realm }}
    displayName: Lab sign-in
    enabled: true
    sslRequired: external
    registrationAllowed: false
    resetPasswordAllowed: false
    bruteForceProtected: true
    # Users can't change their user name: Proxmox builds its user names from it (proxmox_sso_username_claim),
    # and the Proxmox wiki warns that an editable claim lets one user take another's account.
    editUsernameAllowed: false
    # The second factor's settings, the ones authenticator apps assume; each admin's seed matches them.
    otpPolicyType: totp
    otpPolicyAlgorithm: HmacSHA1
    otpPolicyDigits: {{ k8s_identity_otp_digits }}
    otpPolicyPeriod: {{ k8s_identity_otp_period }}
{% if k8s_identity_theme | length > 0 %}
    loginTheme: {{ k8s_identity_theme }}
{% endif %}
    roles:
      realm:
        - {name: admin, description: "Admin in lab apps"}
        - {name: viewer, description: "Read-only in lab apps"}
    groups:
{% for group in k8s_identity_groups %}
      - {name: {{ group.name }}, path: /{{ group.name }}, realmRoles: [{{ group.role }}]}
{% endfor %}
    users:
{% for user in k8s_identity_users %}
      # Keycloak's user profile asks for an email, first and last name before a first sign-in
      # ("Account is not fully set up"), so each user gets all three: the given email or
      # <user name>@lab.invalid (RFC 2606), and the given names or the user name and "Lab".
      - username: {{ user.username }}
        email: {{ user.email if user.email | default('') | length > 0 else user.username ~ '@lab.invalid' }}
        emailVerified: true
        firstName: {{ user.first_name | default(user.username) }}
        lastName: {{ user.last_name | default('Lab') }}
        enabled: true
        groups: [{% for g in user.groups %}/{{ g }}{{ ', ' if not loop.last }}{% endfor %}]
        credentials:
          - {type: password, value: "${{ '{' }}{{ k8s_identity_password_keys[loop.index0] }}{{ '}' }}", temporary: false}
{% if k8s_identity_otp_group in user.groups %}
          # An admin's second factor: a TOTP seed from the values file (base32), so it survives the realm's
          # delete and import. Keycloak's built-in browser and direct grant flows ask for the code from any
          # user who has one ("Condition - user configured"), so every admin is asked.
          - type: otp
            userLabel: lab authenticator
            secretData: '{"value":"${{ '{' }}TOTP_{{ user.username | upper | regex_replace('[^A-Z0-9]', '_') }}{{ '}' }}"}'
            credentialData: '{"subType":"totp","digits":{{ k8s_identity_otp_digits }},"counter":0,"period":{{ k8s_identity_otp_period }},"algorithm":"HmacSHA1","secretEncoding":"BASE32"}'
{% endif %}
{% endfor %}
    clients:
      # Grafana (k8s_observability): a confidential client with the authorization code flow
      # (Grafana docs, "Configure Keycloak OAuth2 authentication") and PKCE S256 (Grafana docs,
      # "Configure generic OAuth2 authentication", use_pkce).
      - clientId: grafana
        name: Grafana
        protocol: openid-connect
        publicClient: false
        clientAuthenticatorType: client-secret
        secret: "${GRAFANA_CLIENT_SECRET}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        implicitFlowEnabled: false
        serviceAccountsEnabled: false
        rootUrl: https://{{ k8s_identity_grafana_hosts | first }}
        baseUrl: /
        redirectUris: {{ k8s_identity_grafana_hosts | map('regex_replace', '^(.*)$', 'https://\\1/login/generic_oauth') | list | to_json }}
        webOrigins: {{ k8s_identity_grafana_hosts | map('regex_replace', '^(.*)$', 'https://\\1') | list | to_json }}
        attributes:
          pkce.code.challenge.method: S256
          # Keycloak separates several post-logout redirect URIs with "##".
          post.logout.redirect.uris: "{{ k8s_identity_grafana_hosts | map('regex_replace', '^(.*)$', 'https://\\1/login') | join('##') }}"
{{ mappers }}
      # Argo CD's web UI (Argo CD docs, "Keycloak"): confidential, code flow. PKCE is allowed, not
      # required, so it works whether or not argocd-cm sets enablePKCEAuthentication. Argo CD's
      # callback is /auth/callback on its own name.
      - clientId: argocd
        name: Argo CD
        protocol: openid-connect
        publicClient: false
        clientAuthenticatorType: client-secret
        secret: "${ARGOCD_CLIENT_SECRET}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        implicitFlowEnabled: false
        serviceAccountsEnabled: false
        rootUrl: https://{{ k8s_identity_argocd_hosts | first }}
        baseUrl: /applications
        redirectUris: {{ k8s_identity_argocd_hosts | map('regex_replace', '^(.*)$', 'https://\\1/auth/callback') | list | to_json }}
        webOrigins: {{ k8s_identity_argocd_hosts | map('regex_replace', '^(.*)$', 'https://\\1') | list | to_json }}
        attributes:
          post.logout.redirect.uris: "{{ k8s_identity_argocd_hosts | map('regex_replace', '^(.*)$', 'https://\\1/applications') | join('##') }}"
{{ mappers }}
      # Argo CD's command line, `argocd login --sso`: a public client (no secret on a laptop) with
      # PKCE, calling back to the CLI's own listener on localhost port 8085.
      - clientId: argocd-cli
        name: Argo CD command line
        protocol: openid-connect
        publicClient: true
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        implicitFlowEnabled: false
        serviceAccountsEnabled: false
        redirectUris: ["http://localhost:8085/auth/callback"]
        webOrigins: []
        attributes:
          pkce.code.challenge.method: S256
{{ mappers }}
      # Jellyfin, through the SSO plugin (jellyfin-plugin-sso): confidential, code flow. The plugin
      # calls back on /sso/OID/redirect/<provider> (older releases) or /sso/OID/r/<provider>.
      - clientId: jellyfin
        name: Jellyfin
        protocol: openid-connect
        publicClient: false
        clientAuthenticatorType: client-secret
        secret: "${JELLYFIN_CLIENT_SECRET}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        implicitFlowEnabled: false
        serviceAccountsEnabled: false
        rootUrl: https://{{ k8s_identity_jellyfin_hosts | first }}
        baseUrl: /
        redirectUris:
{% for host in k8s_identity_jellyfin_hosts %}
          - "https://{{ host }}/sso/OID/redirect/{{ k8s_identity_jellyfin_provider }}"
          - "https://{{ host }}/sso/OID/r/{{ k8s_identity_jellyfin_provider }}"
{% endfor %}
        webOrigins: {{ k8s_identity_jellyfin_hosts | map('regex_replace', '^(.*)$', 'https://\\1') | list | to_json }}
{{ mappers }}
{% if k8s_identity_proxmox_hosts | length > 0 %}
      # Proxmox VE's web UI, through its own OpenID Connect realm (role proxmox_sso; Proxmox wiki, "User
      # Management", OpenID Connect): confidential, code flow. The UI sends its own origin, with no path, as
      # the redirect (pve-manager LoginWindow.js, 'redirect-url': location.origin), so that is what is allowed.
      - clientId: proxmox
        name: Proxmox VE
        protocol: openid-connect
        publicClient: false
        clientAuthenticatorType: client-secret
        secret: "${PROXMOX_CLIENT_SECRET}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        implicitFlowEnabled: false
        serviceAccountsEnabled: false
        rootUrl: https://{{ k8s_identity_proxmox_hosts | first }}
        baseUrl: /
        redirectUris: {{ k8s_identity_proxmox_hosts | map('regex_replace', '^(.*)$', 'https://\\1') | list | to_json }}
        webOrigins: {{ k8s_identity_proxmox_hosts | map('regex_replace', '^(.*)$', 'https://\\1') | list | to_json }}
{{ mappers }}
{% endif %}
{% if k8s_identity_openbao_hosts | length > 0 %}
      # The secrets store's web page, through its OIDC login (Ansible role openbao, tasks/owner_signin.yml;
      # OpenBao docs, "OIDC provider configuration", Keycloak): confidential, code flow. The page calls back on
      # /ui/vault/auth/<mount>/oidc/callback. The store's login role `owner` decides who gets a token (bound to
      # group lab-admins and to the owner's user name), so this client lets any realm user sign in, like the others.
      - clientId: openbao
        name: Secrets store
        protocol: openid-connect
        publicClient: false
        clientAuthenticatorType: client-secret
        secret: "${OPENBAO_CLIENT_SECRET}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        implicitFlowEnabled: false
        serviceAccountsEnabled: false
        rootUrl: https://{{ k8s_identity_openbao_hosts | first }}
        baseUrl: /ui/
        redirectUris: {{ k8s_identity_openbao_hosts | map('regex_replace', '^(.*)$', 'https://\\1/ui/vault/auth/oidc/oidc/callback') | list | to_json }}
        webOrigins: {{ k8s_identity_openbao_hosts | map('regex_replace', '^(.*)$', 'https://\\1') | list | to_json }}
{{ mappers }}
{% endif %}
