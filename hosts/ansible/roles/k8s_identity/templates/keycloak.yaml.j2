# {{ ansible_managed }}
# Keycloak behind the shared Gateway: TLS ends at the Gateway, Keycloak serves plain HTTP inside
# the cluster and trusts the X-Forwarded-* headers the Gateway's Envoy sets (Keycloak operator docs,
# "Basic Keycloak deployment": httpEnabled and proxy.headers for edge TLS). The operator makes no
# Ingress; the HTTPRoute comes from k8s_app_route. The operator's first admin account sits in
# Secret {{ k8s_identity_name }}-initial-admin (break-glass, master realm); nothing here reads it.
apiVersion: k8s.keycloak.org/v2beta1
kind: Keycloak
metadata:
  name: {{ k8s_identity_name }}
  namespace: {{ k8s_identity_namespace }}
spec:
  instances: 1
  db:
    vendor: postgres
    host: {{ k8s_identity_name }}-postgres
    port: 5432
    database: keycloak
    usernameSecret: {name: {{ k8s_identity_db_secret }}, key: username}
    passwordSecret: {name: {{ k8s_identity_db_secret }}, key: password}
  http:
    httpEnabled: true
  hostname:
    hostname: https://{{ k8s_identity_host }}
  proxy:
    headers: xforwarded
  ingress:
    enabled: false
  resources:
    requests: {cpu: 200m, memory: 768Mi}
    limits: {memory: 1536Mi}
{% if k8s_identity_theme | length > 0 %}
  # The sign-in theme (k8s_identity_theme_dir), from ConfigMap keycloak-theme. The operator has no
  # field for themes, so the volume goes through its pod template (Keycloak operator docs,
  # "Advanced configuration", unsupported podTemplate). The hash restarts the pod when a file
  # changes, since Keycloak caches themes.
  unsupported:
    podTemplate:
      metadata:
        annotations:
          central-hub/theme-sha256: "{{ k8s_identity_theme_sha256 }}"
      spec:
        containers:
          - volumeMounts:
              - {name: theme, mountPath: /opt/keycloak/themes/{{ k8s_identity_theme }}, readOnly: true}
        volumes:
          - name: theme
            configMap:
              name: keycloak-theme
              items:
{% for f in k8s_identity_theme_files %}
                - {key: {{ f.key }}, path: {{ f.path }}}
{% endfor %}
{% endif %}
