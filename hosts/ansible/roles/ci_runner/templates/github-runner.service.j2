# Managed by the ci_runner role (central-hub hosts/ansible). The notebook's self-hosted runner.
[Unit]
Description=GitHub Actions runner for {{ ci_runner_repo_url }}
After=network-online.target
Wants=network-online.target

[Service]
User={{ ci_runner_user }}
Group={{ ci_runner_user }}
WorkingDirectory={{ ci_runner_home }}/runner
# Through /bin/sh: SELinux (enforcing on AlmaLinux) stops systemd from running a file under
# /var/lib directly (status 203/EXEC, measured 2026-11-10 on the runner VM). A shell started from
# /bin may run it, and exec hands the runner the service's process.
ExecStart=/bin/sh -c 'exec {{ ci_runner_home }}/runner/run.sh'
Restart=always
RestartSec=15
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
# The jobs run the code in each pull request, so they get no way to gain privileges and see the
# system's files read-only, apart from the runner's home and /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ ci_runner_home }}

[Install]
WantedBy=multi-user.target
