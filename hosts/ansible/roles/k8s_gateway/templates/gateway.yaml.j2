---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k8s_gateway_namespace }}
---
# One shared Gateway for the cluster's web apps. HTTP on 80, and with k8s_gateway_https HTTPS on
# 443 with the wildcard certificate (BUILD-PATH S12). Its address comes from Cilium LB IPAM,
# pinned with spec.addresses (Cilium docs, Gateway API Addresses Support).
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ k8s_gateway_name }}
  namespace: {{ k8s_gateway_namespace }}
spec:
  gatewayClassName: {{ k8s_gateway_class }}
  addresses:
    - type: IPAddress
      value: {{ k8s_gateway_address }}
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      hostname: "*.{{ k8s_gateway_apps_domain }}"
      allowedRoutes:
        namespaces:
          from: All
{% if k8s_gateway_https %}
    # TLS ends here (mode Terminate) with the certificate Secret next to the Gateway.
    - name: https
      protocol: HTTPS
      port: 443
      hostname: "*.{{ k8s_gateway_apps_domain }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ k8s_gateway_tls_secret }}
      allowedRoutes:
        namespaces:
          from: All
{% endif %}
