# Managed by Ansible (role proxmox_proxy). What /usr/local/libexec/proxy-proofs.sh checks.
PROOF_NAME={{ proxmox_proxy_server_names | first | quote }}
PROOF_CA={{ proxmox_proxy_ca_bundle | quote }}
PROOF_NODE={{ ansible_facts['hostname'] | quote }}
PROOF_FRONT_OK={{ proxmox_proxy_proof_front_ok | join(' ') | quote }}
PROOF_API_OK={{ proxmox_proxy_proof_api_ok | join(' ') | quote }}
