#!/bin/sh
# Runs once on the Proxmox console (tty1). The owner types two different passwords, each twice:
#   1. the login password of {{ desktop_user }}, which GDM asks for and which goes to chpasswd on stdin;
#   2. the RDP password, which opens only the RDP layer and goes to grdctl on stdin.
# Neither is on any command line, in a log, or in an agent's reach. They are held in shell variables only.
# The system remote desktop daemon stores the RDP password at rest on this VM (there is no TPM), so a copy
# of it is on the VM's disk and in its backups; that is why it must differ from the login password.
set -eu
umask 077

ask() {  # ask <prompt>: read a password twice without echo until it is non-empty and matches, then leave it in $answer
  while :; do
    printf '%s: ' "$1"; stty -echo; read -r first; stty echo; echo
    printf 'Again: '; stty -echo; read -r second; stty echo; echo
    [ -n "$first" ] && [ "$first" = "$second" ] && break
    echo "Empty or not the same. Try again."
  done
  answer=$first
}

echo
while :; do
  ask "Login password for {{ desktop_user }}"
  login=$answer
  ask "RDP password (different from the login password)"
  rdp=$answer
  [ "$login" != "$rdp" ] && break
  echo "The two passwords must differ. Start again."
done
printf '%s:%s\n' '{{ desktop_user }}' "$login" | chpasswd
printf '%s\n' "$rdp" | grdctl --system rdp set-credentials '{{ desktop_user }}'
grdctl --system rdp enable
unset first second answer login rdp
install -D -m 0644 /dev/null {{ desktop_password_marker }}
