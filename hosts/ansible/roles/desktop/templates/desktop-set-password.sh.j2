#!/bin/sh
# Runs once on the Proxmox console (tty1). The owner types one password twice. It becomes both the
# login password of {{ desktop_user }} and the RDP credential of the remote desktop daemon, and it goes
# nowhere else: it is held in this shell and never written to a file, a log or the command line of
# anything but chpasswd (stdin) and grdctl.
set -eu
umask 077
echo
echo "Set the password for {{ desktop_user }} (login and RDP)."
while :; do
  printf 'Password: '; stty -echo; read -r first; stty echo; echo
  printf 'Again: '; stty -echo; read -r second; stty echo; echo
  [ -n "$first" ] && [ "$first" = "$second" ] && break
  echo "Empty or not the same. Try again."
done
printf '%s:%s\n' '{{ desktop_user }}' "$first" | chpasswd
grdctl --system rdp set-credentials '{{ desktop_user }}' "$first"
grdctl --system rdp enable
unset first second
install -D -m 0644 /dev/null {{ desktop_password_marker }}
