# Managed by the agent_box role (central-hub hosts/ansible). Settings for secrets-bundle.sh (pick 228).
# No secret: the Mac's age recipient is a public key, and the box's identity is its own file.
# The Mac's recipient is optional (pick 236).
BUNDLE_MAC_RECIPIENT={{ agent_box_secrets_bundle.mac_recipient | default('') }}
BUNDLE_KEEP={{ agent_box_secrets_bundle.keep | default(14) }}
# The off-box send (pick 236): the vault secret that holds the box's identity, and how long restic keeps copies.
BUNDLE_VAULT_SECRET={{ agent_box_secrets_bundle.vault_secret | default('secrets-bundle-age-identity') }}
BUNDLE_OFFBOX_KEEP_DAILY={{ agent_box_secrets_bundle.offbox_keep_daily | default(14) }}
BUNDLE_OFFBOX_KEEP_MONTHLY={{ agent_box_secrets_bundle.offbox_keep_monthly | default(6) }}
