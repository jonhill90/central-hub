# Managed by the agent_box role (central-hub hosts/ansible). A missed run (box off) runs at the next boot.
[Unit]
Description=Daily check of the certificate the firewall serves

[Timer]
OnCalendar={{ agent_box_opnsense_cert_check_daily }}
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
