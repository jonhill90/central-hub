# Managed by the agent_box role (central-hub hosts/ansible). Sends the dev secrets store's newest Raft snapshot off
# the box (pick 237). Runs as the keys user; with no store it logs "skipped: no store" and succeeds.
[Unit]
Description=Send the dev secrets store's newest snapshot off the box

[Service]
Type=oneshot
User={{ agent_box_keys_user }}
Group={{ agent_box_keys_user }}
ExecStart={{ agent_box_libexec_dir }}/secrets-store-offbox.sh
