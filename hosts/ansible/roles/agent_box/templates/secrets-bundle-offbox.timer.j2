# Managed by the agent_box role (central-hub hosts/ansible). After the day's bundle; a missed run runs at the next boot.
[Unit]
Description=Daily off-box send of the encrypted bundle of the box's private files

[Timer]
OnCalendar={{ agent_box_secrets_bundle_offbox_daily }}
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
