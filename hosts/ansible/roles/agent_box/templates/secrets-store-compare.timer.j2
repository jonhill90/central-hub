# Managed by the agent_box role (central-hub hosts/ansible). Weekly, while the box is up; a missed run runs at the
# next boot.
[Unit]
Description=Weekly compare of the dev secrets store with its SOPS copy

[Timer]
OnCalendar={{ agent_box_secrets_store_compare_on_calendar }}
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
