# Managed by the agent_box role (central-hub hosts/ansible). Sends the newest secrets bundle off the box, after
# escrowing the box's age identity (pick 236). Runs as the keys user.
[Unit]
Description=Send the newest encrypted bundle of the box's private files off the box
After=secrets-bundle.service

[Service]
Type=oneshot
User={{ agent_box_keys_user }}
Group={{ agent_box_keys_user }}
ExecStart={{ agent_box_libexec_dir }}/secrets-bundle-offbox.sh
