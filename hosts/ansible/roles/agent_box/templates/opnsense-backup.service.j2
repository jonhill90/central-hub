# Managed by the agent_box role (central-hub hosts/ansible). Keeps a fresh copy of OPNsense's
# configuration in {{ agent_box_work_dir }}/opnsense-backup (pick 220). Runs as the keys user.
[Unit]
Description=OPNsense configuration backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ agent_box_keys_user }}
Group={{ agent_box_keys_user }}
ExecStart={{ agent_box_libexec_dir }}/opnsense-backup.sh
