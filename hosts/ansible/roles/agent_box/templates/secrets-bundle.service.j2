# Managed by the agent_box role (central-hub hosts/ansible). Makes one SOPS-encrypted bundle of the box's private
# files (pick 228). Runs as the keys user.
[Unit]
Description=Encrypted bundle of the box's private files

[Service]
Type=oneshot
User={{ agent_box_keys_user }}
Group={{ agent_box_keys_user }}
ExecStart={{ agent_box_libexec_dir }}/secrets-bundle.sh
