# /etc/sudoers.d/agent-box: user {{ agent_box_user }} may run each wrapper as {{ agent_box_keys_user }} (or the
# wrapper's own run_as user), with these arguments only, and nothing else. Managed by the agent_box role (central-hub
# hosts/ansible); checked with visudo before it is written.
Defaults:{{ agent_box_user }} env_reset
{% for w in agent_box_wrappers %}
{# session_args: what the session user may run when that is less than the runner's args (an empty list: nothing). #}
{% set __args = w.session_args if w.session_args is defined else w.args %}
{% if __args | length > 0 %}
{{ agent_box_user }} ALL=({{ w.run_as | default(agent_box_keys_user) }}) NOPASSWD: {{ __args | map('regex_replace', '^', agent_box_libexec_dir ~ '/' ~ w.name ~ '.sh ') | join(', ') }}
{% endif %}
{% endfor %}
{% for w in agent_box_wrappers %}
{% for c in w.callers | default([]) %}
# {{ c.user }} may run {{ w.name }} as {{ w.run_as | default(agent_box_keys_user) }}, with these arguments only (another wrapper's own step).
Defaults:{{ c.user }} env_reset
{{ c.user }} ALL=({{ w.run_as | default(agent_box_keys_user) }}) NOPASSWD: {{ c.args | map('regex_replace', '^', agent_box_libexec_dir ~ '/' ~ w.name ~ '.sh ') | join(', ') }}
{% endfor %}
{% endfor %}
{% if agent_box_inventory_user | length > 0 %}
# inventory.sh's first fill (spec 2026-11-private-values-on-the-box, choice 7): {{ agent_box_inventory_user }} reads the two old copies of the inventory, each as
# its owner, with one exact command and no argument that a caller chooses.
Defaults:{{ agent_box_inventory_user }} env_reset
{{ agent_box_inventory_user }} ALL=({{ agent_box_keys_user }}) NOPASSWD: /usr/bin/cat {{ agent_box_keys_dir }}/prod/inventory-hosts.yml
{{ agent_box_inventory_user }} ALL=({{ agent_box_guard_user }}) NOPASSWD: /usr/bin/cat {{ agent_box_guard_dir }}/inventory/hosts.yml
{% endif %}
{% if agent_box_self_apply | bool %}
# box-apply (D-0036): the box applies its own role from reviewed main, as root, with plan or apply only.
{{ agent_box_user }} ALL=(root) NOPASSWD: {{ agent_box_libexec_dir }}/box-apply.py plan, {{ agent_box_libexec_dir }}/box-apply.py apply
{% endif %}
{% if agent_box_runner_user | length > 0 %}
# The GitHub Actions runner user: only the wrappers marked runner: true, the same fixed arguments.
Defaults:{{ agent_box_runner_user }} env_reset
{% for w in agent_box_wrappers if w.runner | default(false) %}
{{ agent_box_runner_user }} ALL=({{ w.run_as | default(agent_box_keys_user) }}) NOPASSWD: {{ w.args | map('regex_replace', '^', agent_box_libexec_dir ~ '/' ~ w.name ~ '.sh ') | join(', ') }}
{% endfor %}
{% endif %}
