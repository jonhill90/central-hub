# {{ agent_box_host_dir }}/inventory/hosts.yml: the Proxmox host job's inventory (wrapper proxmox-host). Managed by
# the agent_box role from the controller only (tag proxmox_host_inventory); private, the job's user's only.
proxmox:
  hosts:
    proxmox_host:
      ansible_host: {{ agent_box_proxmox_host.address | to_json }}
      ansible_user: root
      ansible_ssh_private_key_file: {{ (agent_box_host_dir ~ '/id_ed25519') | to_json }}
      ansible_ssh_common_args: {{ ('-o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=' ~ agent_box_host_dir ~ '/known_hosts') | to_json }}
      ansible_python_interpreter: /usr/bin/python3
      proxmox_cert_names: {{ agent_box_host_cert_names | to_json }}
{% if agent_box_proxmox_host_sso | length > 0 %}
      # Role proxmox_sso (job sso): Keycloak's issuer for realm lab and c1's Gateway address for the host's /etc/hosts line.
      proxmox_sso_issuer: {{ agent_box_proxmox_host_sso.issuer | to_json }}
      proxmox_sso_address: {{ agent_box_proxmox_host_sso.address | default('') | to_json }}
{% endif %}
{% set __pf = hostvars[groups['proxmox'][0]] if (groups['proxmox'] | default([]) | length) > 0 else {} %}
{% if __pf.proxmox_firewall_home_lan_cidr is defined %}
      # Role proxmox_firewall (job firewall, D-0063): the host's private firewall values, from the controller's own entry for the
      # host. The nodes the checks probe are listed here, because this inventory has no k8s_nodes group.
      proxmox_firewall_home_lan_cidr: {{ __pf.proxmox_firewall_home_lan_cidr | to_json }}
      proxmox_firewall_enable: {{ __pf.proxmox_firewall_enable | default(false) | bool | to_json }}
      proxmox_firewall_extra_rules: {{ __pf.proxmox_firewall_extra_rules | default([]) | to_json }}
      proxmox_firewall_check_targets: {{ (groups['k8s_nodes'] | default([])) | map('extract', hostvars) | map(attribute='ansible_host', default='') | select | list | to_json }}
{% endif %}
{% if agent_box_proxmox_host_restic_reader | length > 0 %}
      # Role proxmox_restic_sftp (job restore-reader): the read-only backup user's keys, each {key, from}: one ssh public key line and
      # the one address it works from (a dev worker's). The key lines are public.
      proxmox_restic_reader_keys: {{ agent_box_proxmox_host_restic_reader | to_json }}
{% endif %}
