# Managed by the agent_box role (central-hub hosts/ansible). Settings for opnsense-offbox.sh and azure-cert.py
# (pick 222). No secret: the certificate's key and the repository password are their own files, made on the box.
RESTIC_REPOSITORY={{ agent_box_opnsense_offbox.repository | default('azure:opnsense-backup:/opnsense') }}
RESTIC_PASSWORD_FILE={{ agent_box_keys_dir }}/opnsense-offbox/restic-password.txt
AZURE_ACCOUNT_NAME={{ agent_box_opnsense_offbox.account }}
AZURE_CLIENT_ID={{ agent_box_opnsense_offbox.client_id }}
AZURE_TENANT_ID={{ agent_box_opnsense_offbox.tenant_id }}
AZURE_APP_OBJECT_ID={{ agent_box_opnsense_offbox.app_object_id }}
OFFBOX_VAULT_URL={{ agent_box_opnsense_offbox.vault_url }}
OFFBOX_VAULT_SECRET={{ agent_box_opnsense_offbox.vault_secret | default('opnsense-offbox-restic-password') }}
AZURE_CLIENT_CERTIFICATE_PATH={{ agent_box_keys_dir }}/opnsense-offbox/azure.pem
BACKUP_CERT_DAYS={{ agent_box_opnsense_offbox_cert_days }}
BACKUP_CERT_RENEW_DAYS={{ agent_box_opnsense_offbox_cert_renew_days }}
OFFBOX_KEEP_DAILY={{ agent_box_opnsense_offbox.keep_daily | default(30) }}
OFFBOX_KEEP_MONTHLY={{ agent_box_opnsense_offbox.keep_monthly | default(12) }}
