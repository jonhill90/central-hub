# Managed by the agent_box role (central-hub hosts/ansible). `tick` is the run a session gets from `box-apply apply`
# (D-0036), except that it ends at once, applying nothing, when main has not moved past the baseline. Like apply,
# it applies reviewed main and stops on any limit change that main holds no approval line for. Exit 3 (waiting on
# a line) is a normal stop, not a failure. Its record is /var/lib/box-apply's log, as for a session run.
[Unit]
Description=box-apply: apply this box's role from reviewed main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/
ExecStart={{ agent_box_libexec_dir }}/box-apply.py tick
SuccessExitStatus=3
TimeoutStartSec=30min
