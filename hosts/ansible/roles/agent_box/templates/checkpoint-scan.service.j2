# Managed by the agent_box role (central-hub hosts/ansible). The hourly checkpoint as a box script: it reads GitHub and
# the pass ledger, and wakes a session through checkpoint-note only on a new finding. Runs as the keys user, the same
# user the wrapper runs as through sudo. Exit 3 means findings, not a failure.
[Unit]
Description=Checkpoint scan: wake a session only on a finding
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ agent_box_keys_user }}
Group={{ agent_box_keys_user }}
ExecStart={{ agent_box_libexec_dir }}/checkpoint-scan.sh run
SuccessExitStatus=3
TimeoutStartSec=5min
