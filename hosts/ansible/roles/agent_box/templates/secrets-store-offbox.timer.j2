# Managed by the agent_box role (central-hub hosts/ansible). Hourly, while the box is up; a missed run runs at the next boot.
[Unit]
Description=Hourly off-box send of the dev secrets store's snapshot

[Timer]
OnCalendar={{ agent_box_secrets_store_offbox_on_calendar }}
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
