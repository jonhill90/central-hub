# Managed by the agent_box role (central-hub hosts/ansible). Compares every key of the dev secrets store's SOPS copy
# with the store (D-0058 rule 8): names only a key that differs, never a value or a hash, and fails when one does.
# Runs as the keys user, the same as the wrapper does through sudo.
[Unit]
Description=Weekly compare of the dev secrets store with its SOPS copy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ agent_box_keys_user }}
Group={{ agent_box_keys_user }}
ExecStart={{ agent_box_libexec_dir }}/secrets-store.sh compare
