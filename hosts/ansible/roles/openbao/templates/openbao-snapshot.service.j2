[Unit]
Description=OpenBao Raft snapshot (D-0038 rule 8)
After=openbao.service
Requires=openbao.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/openbao-snapshot.sh {{ openbao_port }} {{ openbao_snapshot_dir }} {{ openbao_snapshot_keep }}
PrivateTmp=yes
