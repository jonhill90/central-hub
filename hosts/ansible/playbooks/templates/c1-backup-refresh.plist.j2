<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by playbooks/controller-backup-refresh.yml. Edit that, not this file. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ controller_backup_refresh_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ controller_backup_refresh_ansible }}</string>
    <string>-i</string>
    <string>inventories/home/</string>
    <string>playbooks/k8s-backup.yml</string>
    <string>--tags</string>
    <string>timers</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ controller_backup_refresh_dir }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ controller_backup_refresh_path }}</string>
  </dict>
  <!-- Every day at this hour, local time; a run missed while the Mac slept starts when it wakes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>{{ controller_backup_refresh_hour }}</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ controller_backup_refresh_log }}</string>
  <key>StandardErrorPath</key>
  <string>{{ controller_backup_refresh_log }}</string>
</dict>
</plist>
