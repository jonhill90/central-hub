# The agent_box role writes the real values to /var/lib/agent-box/secrets-store.json from the private
# inventory. Made-up values shaped by STD-0001.
proxmox_node_name = "examplehv01"
vnet              = "dev"
vlans_file        = "/var/lib/agent-box/checkouts/secrets-store/hosts/ansible/inventories/home/group_vars/all/vlans.yml"
template_vm_id    = 9001
ssh_public_key    = "ssh-ed25519 AAAA... keys@agentbox"
store = { name = "daldapdemo01", vm_id = 550, address = "10.1.30.92", cores = 2, memory_mb = 2048, disk_gb = 20 }
