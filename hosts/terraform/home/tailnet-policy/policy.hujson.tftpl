// Tailnet policy file, rendered by hosts/terraform/home/tailnet-policy (tailscale_acl).
// Built from the 2026-10-23 draft for the connector design, which was not applied then.
// Tags and the lab's ranges only; the Proxmox host's address is filled in at apply time.
{
%{ if length(external_tailnets) > 0 ~}
	// Groups that the external tailnets below may name in their own grants. Members are private
	// values (home.tfvars).
	"groups": {
%{ for alias, t in external_tailnets ~}
		"group:${t.group}": ${jsonencode(t.members)},
%{ endfor ~}
	},

	// Declarative node sharing (alpha): each listed tailnet may share its own devices with the
	// group it names here. allowIncomingConnections is written false in this template, not taken
	// from a value, so no listed tailnet can reach a device in this one.
	"externalTailnets": {
%{ for alias, t in external_tailnets ~}
		"${alias}": {
			"externalID":                ${jsonencode(t.external_id)},
			"allowIncomingConnections":  false,
			// The group, and the share pod's tag (below): the pod is the only device that gets a path
			// to the shared node, so no one's own machine needs one.
			"allowExternalReferencesTo": ["group:${t.group}", "tag:share-pod"],
		},
%{ endfor ~}
	},

%{ endif ~}
	"tagOwners": {
		"tag:github-actions": ["autogroup:admin"],
		"tag:vps":            ["autogroup:admin", "tag:vps"],
		"tag:agent":          ["autogroup:admin", "tag:agent"],
		// The tailnet connector, CT 900 (home/remote-access)
		"tag:connector":      ["autogroup:admin"],
		// The agent box on dev (the owner's yes of 2026-11-09 at 08:14 UTC; tag name chosen 2026-11-10 at 06:18 UTC)
		"tag:agent-box":      ["autogroup:admin"],
%{ if length(external_tailnets) > 0 ~}
		// The share pod on c1 (apps/share-pod): holds no lab secret, reaches only the shared node
		"tag:share-pod":      ["autogroup:admin"],
%{ endif ~}
	},

	// The connector's routes are turned on without a click: the Proxmox host's address and every
	// lab VLAN from the shared VLAN file. home/tailnet turns the same list on through the API.
	"autoApprovers": {
		"routes": {
			"${proxmox_host_address}/32": ["tag:connector"],
%{ for r in lab_ranges ~}
			"${r}": ["tag:connector"],
%{ endfor ~}
		},
	},

	"grants": [
		// Admins reach everything, including the lab through the connector
		{"src": ["autogroup:admin"], "dst": ["*"], "ip": ["*"]},

		// Each member's own devices reach each other
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

		// Agent cloud sessions: the VPS on SSH and the Kubernetes API
		{"src": ["tag:agent"], "dst": ["tag:vps"], "ip": ["tcp:22", "tcp:6443"]},

		// Agent cloud sessions: the Proxmox host on SSH only, through the connector
		{"src": ["tag:agent"], "dst": ["${proxmox_host_address}/32"], "ip": ["tcp:22"]},

		// Agent cloud sessions: the agent box on SSH only (the owner's yes of 2026-11-09 at 08:14 UTC).
		{"src": ["tag:agent"], "dst": ["tag:agent-box"], "ip": ["tcp:22"]},

		// The agent box: the VPS on SSH only, for the vps-host pipeline job (D-0046 rule 4, S1). With the share
		// pod below (only when external tailnets are set), these are the box's only destinations, so it has no path to the Mac or the lab.
		{"src": ["tag:agent-box"], "dst": ["tag:vps"], "ip": ["tcp:22"]},
%{ if length(external_tailnets) > 0 ~}

		// The agent box reaches the share pod on one port, which forwards to the shared node. The
		// pod gets no grant here, so it reaches nothing of this tailnet; what it reaches in the
		// other tailnet is that tailnet's own grant for the tag.
		{"src": ["tag:agent-box"], "dst": ["tag:share-pod"], "ip": ["tcp:2222"]},
%{ endif ~}
	],

	"ssh": [
		// D-0046 rule 4, S1: agent sessions sign in to the VPS as deploy only, whose sudo allows vps-apply only.
		{"action": "accept", "src": ["tag:agent"], "dst": ["tag:vps"], "users": ["deploy"]},
		{"action": "accept", "src": ["tag:agent"], "dst": ["tag:agent-box"], "users": ["claude"]},
		// S4: after the first host apply (S3), the box signs in as deploy only, whose sudo allows vps-apply only.
		{"action": "accept", "src": ["tag:agent-box"], "dst": ["tag:vps"], "users": ["deploy"]},
		{"action": "accept", "src": ["autogroup:admin"], "dst": ["tag:vps"], "users": ["root", "deploy", "autogroup:nonroot"]},
		{"action": "check", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]},
	],

	// The tailnet refuses to save the policy if any of these fail, so an open grant can't come
	// back unnoticed.
	"tests": [
		{
			"src":    "tag:agent",
			"accept": ["${proxmox_host_address}:22"],
			"deny":   ["${proxmox_host_address}:8006", "${proxmox_host_address}:443", "${proxmox_host_address}:3389"],
		},
		{
			"src":    "tag:agent-box",
			"accept": ["tag:vps:22"],
			"deny":   ["${proxmox_host_address}:22", "${proxmox_host_address}:8006", "${proxmox_host_address}:443"],
		},
		{
			// The VPS starts nothing toward the lab: the Proxmox host and the first address of every lab VLAN
			// (D-0046 rule 3).
			"src":  "tag:vps",
			"deny": [
				"${proxmox_host_address}:22", "${proxmox_host_address}:8006", "${proxmox_host_address}:443",
%{ for h in lab_test_hosts ~}
				"${h}:22", "${h}:443",
%{ endfor ~}
			],
		},
%{ if length(external_tailnets) > 0 ~}
		{
			"src":    "tag:agent-box",
			"accept": ["tag:share-pod:2222"],
			"deny":   ["tag:share-pod:22"],
		},
		{
			"src":  "tag:share-pod",
			"deny": ["${proxmox_host_address}:22", "${proxmox_host_address}:8006", "tag:vps:22", "tag:agent-box:22"],
		},
%{ endif ~}
	],

	// The tailnet refuses a policy whose SSH tests fail, so root can't come back for agent sessions or the box unnoticed.
	"sshTests": [
		{"src": "tag:agent", "dst": ["tag:vps"], "accept": ["deploy"], "deny": ["root", "omniroute", "openclaw", "hermes"]},
		{"src": "tag:agent-box", "dst": ["tag:vps"], "accept": ["deploy"], "deny": ["root", "omniroute", "openclaw", "hermes"]},
	],
}
