# Made-up example. The real zone goes only in home.tfvars (git-ignored).
# Copy to home.tfvars and pass -var-file=home.tfvars.
zone_name            = "example.com"
bootstrap_token_file = "~/.config/central-hub/cloudflare-bootstrap-token.txt"
token_file           = "~/.config/central-hub/cloudflare-dns-records-token.txt" # same as ../dns token_file
