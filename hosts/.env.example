# Copy to hosts/.env (git-ignored, chmod 600) and fill in. Load it before a run:
#   set -a; . hosts/.env; set +a
# Lab credentials live here until the lab is rebuilt from code; they are changed at the rebuild.

# hosts/terraform/home/tailnet: a tailnet OAuth client with scopes dns, devices:routes and
# devices:core:read (docs/runbooks/set-up-lab-dns.md step 3).
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
