# OpenClaw gateway (D-0046 rules 1 to 3, 9 and 11). Config only. Runs as Quadlet unit
# openclaw.service of Linux user `openclaw`. Pinned by digest, never built on the VPS.
# D-0046 rule 2 says the gateway runs as a plain Node process. This unit runs it in the image's own container
# instead, so it gets a memory cap now; its tool sandboxes stay off (rule 9) until the sandbox proof.
[Unit]
Description=OpenClaw gateway, rootless, loopback only
# The owner's provider key (S7) and OpenClaw's own config land here. Until they exist the unit is skipped.
ConditionPathExists=%h/.config/vps-apps/secrets.env

[Container]
# Version 2026.10.10, built 2026-11-02. 2026.11.1 (2026-11-05) is under STD-0003's two weeks on 2026-11-18.
Image=ghcr.io/openclaw/openclaw@sha256:1e5ee6c7d02d5b5f64f9cf26a30c7ef7d4ec292f0d25fa590f4b7e103e8bf799
ContainerName=openclaw
# D-0046 rule 1: 3 GiB.
Memory=3g
PodmanArgs=--memory-swap=3g
PidsLimit=1024
# Loopback on the host. 18789 is chosen here and passed to the gateway below, not read from the image.
PublishPort=127.0.0.1:18789:18789
# The image runs as its user `node` (uid 1000). keep-id maps that to this Linux user, so the data folder is writable.
UserNS=keep-id:uid=1000,gid=1000
Volume=%h/data:/home/node/.openclaw:Z
EnvironmentFile=%h/.config/vps-apps/secrets.env
# --bind lan means "all interfaces inside the container"; the host side is the loopback publish above.
Exec=node openclaw.mjs gateway --port 18789 --bind lan
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
