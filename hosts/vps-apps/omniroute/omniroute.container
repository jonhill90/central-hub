# OmniRoute (D-0046 rules 1 to 3 and 11). Config only: no secret, host name or key. Runs as the Quadlet unit
# omniroute.service of Linux user `omniroute`, in that user's rootless Podman. Installed by role vps_app_host.
# The image is pinned by digest: it is pulled, never built on the VPS.
[Unit]
Description=OmniRoute (model router), rootless, loopback only
# `vps-apply secrets` (S5) makes this file. With no secrets the unit is skipped, not started and not failed.
ConditionPathExists=%h/.config/vps-apps/secrets.env

[Container]
# Version 3.8.52, pushed 2026-10-20. 3.8.53 (2026-11-06) is under STD-0003's two weeks on 2026-11-18.
Image=docker.io/diegosouzapw/omniroute@sha256:b08a12e876baa8a5ccadd1ebbe346fe7267dba3b1c9f4fd6bb02070fae41ab6c
ContainerName=omniroute
# D-0046 rule 1: 2.5 GiB. Quadlet turns this into podman's --memory, which a hand-run container got no cap from.
Memory=2560m
PodmanArgs=--memory-swap=2560m
PidsLimit=512
# D-0046 rule 3: the host side is loopback. The app listens on all interfaces inside its own container.
PublishPort=127.0.0.1:20128:20128
# The image runs as its user `node` (uid 1000). keep-id maps that to this Linux user, so the data folder is writable.
UserNS=keep-id:uid=1000,gid=1000
Volume=%h/data:/app/data:Z
EnvironmentFile=%h/.config/vps-apps/secrets.env
Environment=REQUIRE_API_KEY=true
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
