# Hermes Agent (D-0046 rules 1, 3 and 11). Config only. Runs as Quadlet unit hermes.service of Linux user
# `hermes`. Pinned by digest, never built on the VPS. Browser tools stay off (rule 1: 4 GiB assumes it).
[Unit]
Description=Hermes Agent, rootless, no published port
# The owner's provider key (S7) lands here. Until it exists the unit is skipped.
ConditionPathExists=%h/.config/vps-apps/secrets.env

[Container]
# Version v0.23.1, built 2026-11-10 (image config `created`, read from Docker Hub 2026-11-28). v0.23.2 (2026-11-16) is under STD-0003's two weeks on 2026-11-28.
Image=docker.io/nousresearch/hermes-agent@sha256:276d44685c65c0cb2a25f190b63c65c8906f9dc76486fb1c05ae71b5826bda08
ContainerName=hermes
# D-0046 rule 1: 4 GiB.
Memory=4g
PodmanArgs=--memory-swap=4g
PidsLimit=1024
# The image exposes no port, so nothing is published: nothing can listen on the VPS for this app (rule 3).
Volume=%h/data:/opt/data:Z
EnvironmentFile=%h/.config/vps-apps/secrets.env
# The image's long-running command, as its Docker page runs it (`docker run ... nousresearch/hermes-agent gateway run`,
# read 2026-11-28). Not yet tested: the first start is the test. No dashboard: HERMES_DASHBOARD stays unset.
Exec=gateway run

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
