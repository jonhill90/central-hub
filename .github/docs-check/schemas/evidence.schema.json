{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "$comment": "docs/research/NNNN-slug.md (D-0016 rule 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["record", "batch", "researched", "method", "checks"],
  "properties": {
    "record": { "$ref": "common.schema.json#/$defs/decisionId" },
    "batch": { "type": "string", "pattern": "^RB-\\d{4}\\b", "$comment": "starts with the batch ID; a short note may follow (docs/research/0008)" },
    "researched": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}( to \\d{4}-\\d{2}-\\d{2})?$" },
    "method": { "type": "string", "minLength": 1 },
    "checks": { "type": "string", "minLength": 1 }
  }
}
